DATA_ROOT=/data
MAX_IMAGE_SIZE_BYTES=10485760
SUPPORTED_IMAGE_EXTENSIONS=.jpg,.jpeg,.png,.webp
HF_HOME=/home/app/.cache/huggingface

DATABASE_URL=postgresql://dinov2:dinov2@postgres:5432/dinov2
DINO_MODEL_NAME=facebook/dinov2-small
DINO_EMBEDDING_DIMENSION=384
DEFAULT_TOP_K=20
RAW_RETRIEVAL_LIMIT=100

# Wine catalog pipeline (HTTP requests are sequential and rate limited).
WINE_SCRAPER_USER_AGENT=SvoeVinO-wine-catalog-pipeline/1.0

# Используется как значение по умолчанию в docker-compose.yml.
# Локальные изображения размещаются в ./data.
