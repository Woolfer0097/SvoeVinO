DATA_ROOT=/data
MAX_IMAGE_SIZE_BYTES=10485760
SUPPORTED_IMAGE_EXTENSIONS=.jpg,.jpeg,.png,.webp
DEVICE=auto
MAX_NUM_KEYPOINTS=2048
SUPERPOINT_RESIZE=1024
LIGHTGLUE_DEPTH_CONFIDENCE=0.95
LIGHTGLUE_WIDTH_CONFIDENCE=0.99
MATCH_FILTER_THRESHOLD=0.1
MIN_MATCHES=15
MIN_INLIERS=12
MIN_INLIER_RATIO=0.3
RANSAC_REPROJ_THRESHOLD=5.0
RANSAC_CONFIDENCE=0.999
TORCH_HOME=/home/app/.cache/torch
APP_UID=1000
APP_GID=1000
API_PORT=8001

# Каталог эталонов — PostgreSQL dinov2_retrieval.
# На хосте это 127.0.0.1:5433. В контейнере 127.0.0.1 — сам контейнер,
# поэтому Compose по умолчанию ходит на host.docker.internal:5433.
DATABASE_URL=postgresql://dinov2:dinov2@host.docker.internal:5433/dinov2
